{
  "name": "chhanni",
  "version": "0.4.0",
  "description": "A sieve for everything you paste into an AI. Reads the attachment too: DOCX, XLSX, PPTX, PDF and image metadata, on your device, with no network permission.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chhanni": "bin/chhanni.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./detect": "./src/detect.js",
    "./redact": "./src/redact.js",
    "./documents": "./src/documents.js"
  },
  "files": [
    "src",
    "bin",
    "extension",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/build.js && node test/e2e/run.mjs",
    "test:perf": "node scripts/build.js && node test/perf/run.mjs",
    "scan": "node bin/chhanni.js",
    "test:providers": "node scripts/build.js && node test/provider/run.mjs"
  },
  "keywords": [
    "dlp",
    "secrets",
    "redaction",
    "prompt",
    "llm",
    "chrome-extension",
    "pii",
    "dpdp"
  ],
  "dependencies": {},
  "devDependencies": {}
}
